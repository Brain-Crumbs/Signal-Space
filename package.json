{
  "name": "signal-space",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev": "npm run dev -w @signal-space/web",
    "cli": "npm run cli -w @signal-space/cli --",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test test/*.test.js test/*.test.ts",
    "test:browser": "playwright test",
    "build": "npm run build -w @signal-space/cli && npm run build -w @signal-space/web",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "tsx": "4.23.13",
    "eslint": "10.10.0",
    "@eslint/js": "10.0.1",
    "typescript-eslint": "8.70.0",
    "prettier": "3.9.6",
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1"
  }
}
