{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-space.dev/agents/experiment-plan.v1.schema.json",
  "title": "Locked experiment design, separate from registered runtime configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "model_id",
    "question",
    "source_equations",
    "runtime_config",
    "runtime_config_sha256",
    "method",
    "hypotheses",
    "controls",
    "criteria",
    "visualization_plan",
    "resources",
    "locked_sha256"
  ],
  "properties": {
    "schema_version": { "const": "signal-space-plan-v1" },
    "experiment_id": { "type": "string", "minLength": 1 },
    "model_id": { "type": "string", "minLength": 1 },
    "question": { "type": "string", "minLength": 10 },
    "source_equations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "runtime_config": {
      "type": "string",
      "minLength": 1,
      "description": "Registered resolved runtime config path or immutable locator; this schema does not replace the runtime config schema."
    },
    "runtime_config_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "units",
        "domain",
        "boundaries",
        "initial_data",
        "solver",
        "tolerances"
      ],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "units": { "type": "string", "minLength": 1 },
        "domain": { "type": "string", "minLength": 1 },
        "boundaries": { "type": "string", "minLength": 1 },
        "initial_data": { "type": "string", "minLength": 1 },
        "solver": { "type": "string", "minLength": 1 },
        "tolerances": { "type": "string", "minLength": 1 }
      }
    },
    "hypotheses": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/$defs/hypothesis" }
    },
    "controls": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/control" }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/criterion" }
    },
    "visualization_plan": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/visual" }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_wall_seconds", "max_memory_mb", "max_output_mb"],
      "properties": {
        "max_wall_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "max_memory_mb": { "type": "number", "exclusiveMinimum": 0 },
        "max_output_mb": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "prohibited_inferences": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "locked_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "hypothesis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prediction"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "prediction": { "type": "string", "minLength": 1 }
      }
    },
    "control": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "purpose", "method"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "purpose": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "observable",
        "pass_if",
        "fail_if",
        "unresolved_if",
        "uncertainty"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "observable": { "type": "string", "minLength": 1 },
        "pass_if": { "type": "string", "minLength": 1 },
        "fail_if": { "type": "string", "minLength": 1 },
        "unresolved_if": { "type": "string", "minLength": 1 },
        "uncertainty": { "type": "string", "minLength": 1 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "figure_id",
        "question",
        "role",
        "observables",
        "representation",
        "competing_signatures",
        "controls",
        "uncertainty",
        "source_data",
        "transformations",
        "required"
      ],
      "properties": {
        "figure_id": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
        "question": { "type": "string", "minLength": 1 },
        "role": { "enum": ["illustrative", "diagnostic", "evidentiary"] },
        "observables": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "representation": { "type": "string", "minLength": 1 },
        "competing_signatures": {
          "type": "object",
          "minProperties": 2,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "controls": { "type": "array", "items": { "type": "string" } },
        "uncertainty": { "type": "string", "minLength": 1 },
        "source_data": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "transformations": { "type": "array", "items": { "type": "string" } },
        "required": { "type": "boolean" }
      }
    }
  }
}
