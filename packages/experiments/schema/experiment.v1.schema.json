{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-space.dev/schema/experiment.v1.schema.json",
  "title": "Signal Space Paper I experiment definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "scenario",
    "mode",
    "until",
    "windows",
    "tolerances",
    "replicates",
    "seed",
    "observables",
    "budgets"
  ],
  "properties": {
    "schemaVersion": { "const": "paper-i-experiment-v1" },
    "id": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "scenario": {
      "$ref": "https://signal-space.dev/schema/scenario.v1.schema.json"
    },
    "mode": { "enum": ["inspect", "envelope", "packets"] },
    "until": { "type": "number", "minimum": 0 },
    "envelope": { "type": "object" },
    "packets": { "type": "object" },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "values"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "values": { "type": "array", "minItems": 1 }
        }
      }
    },
    "variants": { "type": "array" },
    "controls": { "type": "array" },
    "interventions": { "type": "array" },
    "windows": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transient", "measurement"],
      "properties": {
        "transient": { "type": "number", "minimum": 0 },
        "measurement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "number", "minimum": 0 },
            "end": { "type": "number", "minimum": 0 }
          }
        },
        "nested": { "type": "array" }
      }
    },
    "tolerances": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "relative"],
      "properties": {
        "absolute": { "type": "number", "exclusiveMinimum": 0 },
        "relative": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "replicates": { "type": "integer", "minimum": 1, "maximum": 10000 },
    "seed": { "type": "string", "minLength": 1 },
    "observables": {
      "type": "array",
      "items": {
        "enum": [
          "phase",
          "frequency",
          "rates",
          "ticks",
          "retarded-phase",
          "packets",
          "observer-records"
        ]
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxJobs"],
      "properties": {
        "maxJobs": { "type": "integer", "minimum": 1, "maximum": 64 },
        "maxSteps": { "type": "integer", "minimum": 1 },
        "maxEvents": { "type": "integer", "minimum": 1 },
        "maxPending": { "type": "integer", "minimum": 1 },
        "checkpointEvery": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
