{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-space.dev/schema/scenario.v1.schema.json",
  "title": "Signal Space Paper I Scenario v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "modelVersion",
    "id",
    "c0",
    "rateScale",
    "filterWidth",
    "nodes",
    "links",
    "boundaries",
    "initialHistory",
    "interventions",
    "observation",
    "solver",
    "units"
  ],
  "properties": {
    "modelVersion": {
      "const": "paper-i-v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "c0": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "rateScale": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "filterWidth": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["left", "right"],
      "properties": {
        "left": {
          "$ref": "#/$defs/boundary"
        },
        "right": {
          "$ref": "#/$defs/boundary"
        }
      }
    },
    "initialHistory": {
      "type": "object",
      "required": [
        "startTime",
        "endTime",
        "nodes",
        "pendingPackets",
        "filters",
        "pendingResponses"
      ],
      "properties": {
        "startTime": {
          "type": "number",
          "exclusiveMaximum": 0
        },
        "endTime": {
          "const": 0
        },
        "nodes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["phiAtZero", "omega"],
            "properties": {
              "phiAtZero": {
                "type": "number"
              },
              "omega": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          }
        },
        "pendingPackets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/packet"
          }
        },
        "filters": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["left", "right"],
            "properties": {
              "left": {
                "type": "number",
                "minimum": 0
              },
              "right": {
                "type": "number",
                "minimum": 0
              }
            }
          }
        },
        "pendingResponses": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["nodeId", "dueTime", "payload"],
            "properties": {
              "nodeId": {
                "type": "string",
                "minLength": 1
              },
              "dueTime": {
                "type": "number",
                "minimum": 0
              },
              "payload": {}
            }
          }
        },
        "rngState": {
          "type": "object",
          "required": ["algorithm", "state"],
          "properties": {
            "algorithm": {
              "type": "string",
              "minLength": 1
            },
            "state": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "interventions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["time", "kind", "target"],
        "properties": {
          "time": {
            "type": "number",
            "minimum": 0
          },
          "kind": {
            "enum": ["remove-pulse", "add-probe", "change-parameter"]
          },
          "target": {
            "type": "string",
            "minLength": 1
          },
          "value": {}
        }
      }
    },
    "observation": {
      "type": "object",
      "required": ["sampleTimes", "visible", "detectorLatency"],
      "properties": {
        "sampleTimes": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "visible": {
          "type": "array",
          "items": {
            "enum": [
              "local-phase",
              "local-frequency",
              "arrival-time",
              "reported-count"
            ]
          }
        },
        "detectorLatency": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "solver": {
      "type": "object",
      "required": ["method", "absoluteTolerance", "relativeTolerance"],
      "properties": {
        "method": {
          "enum": ["rk4", "dopri5", "event"]
        },
        "step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "absoluteTolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "relativeTolerance": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "units": {
      "type": "object",
      "required": [
        "time",
        "length",
        "angle",
        "rate",
        "angularFrequency",
        "density"
      ],
      "properties": {
        "time": {
          "const": "s"
        },
        "length": {
          "const": "m"
        },
        "angle": {
          "const": "rad"
        },
        "rate": {
          "const": "s^-1"
        },
        "angularFrequency": {
          "const": "rad s^-1"
        },
        "density": {
          "const": "s^-1"
        }
      }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": [
        "id",
        "position",
        "omega0",
        "omega",
        "phi",
        "amplitude",
        "gain",
        "relaxationTime",
        "emission",
        "response"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "position": {
          "type": "number"
        },
        "omega0": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "omega": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "phi": {
          "type": "number"
        },
        "amplitude": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gain": {
          "type": "number"
        },
        "relaxationTime": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "emission": {
          "oneOf": [
            {
              "$ref": "#/$defs/emissionE0"
            },
            {
              "$ref": "#/$defs/emissionE1"
            }
          ]
        },
        "response": {
          "enum": ["R0", "R1", "R2"]
        }
      }
    },
    "emissionE0": {
      "type": "object",
      "additionalProperties": false,
      "required": ["law", "nu"],
      "properties": {
        "law": {
          "const": "E0"
        },
        "nu": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "emissionE1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["law", "q"],
      "properties": {
        "law": {
          "const": "E1"
        },
        "q": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "boundary": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "const": "open"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "rate"],
          "properties": {
            "kind": {
              "const": "driven"
            },
            "rate": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "exteriorDistance"],
          "properties": {
            "kind": {
              "const": "mirror"
            },
            "exteriorDistance": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "closureDelay"],
          "properties": {
            "kind": {
              "const": "periodic"
            },
            "closureDelay": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        }
      ]
    },
    "link": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "sourcePort",
        "targetPort",
        "delay"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "sourcePort": {
          "enum": ["left", "right"]
        },
        "targetPort": {
          "enum": ["left", "right"]
        },
        "delay": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "packet": {
      "type": "object",
      "required": [
        "id",
        "source",
        "target",
        "emissionTime",
        "arrivalTime",
        "port"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "emissionTime": {
          "type": "number"
        },
        "arrivalTime": {
          "type": "number"
        },
        "port": {
          "enum": ["left", "right"]
        }
      }
    }
  }
}
