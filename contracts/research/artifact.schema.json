{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-space.dev/contracts/research/artifact.schema.json",
  "title": "Signal Space research artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "path", "sha256", "size", "media_type"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-zA-Z0-9._-]+$" },
    "kind": {
      "enum": [
        "config",
        "provenance",
        "event-log",
        "checkpoint",
        "raw",
        "derived",
        "check",
        "plot-data",
        "figure",
        "report"
      ]
    },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "size": { "type": "integer", "minimum": 0 },
    "media_type": { "type": "string", "minLength": 1 },
    "source_ids": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    }
  }
}
