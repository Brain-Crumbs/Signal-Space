{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://signal-space.dev/contracts/research/event.schema.json",
  "title": "Signal Space research event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sequence",
    "timestamp",
    "type",
    "stage",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "research-event-v1" },
    "sequence": { "type": "integer", "minimum": 1 },
    "timestamp": { "type": "string", "format": "date-time" },
    "type": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["prepare", "run", "analyze", "report", "runtime"] },
    "payload": { "type": "object" }
  }
}
