{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Test 8 axisymmetric calibration pilot, separate from full acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "model_id",
    "parameters",
    "units",
    "seeds",
    "resources",
    "analysis",
    "report"
  ],
  "properties": {
    "schema_version": { "const": "research-experiment-v1" },
    "experiment_id": { "const": "gross.two-object-calibration.v1" },
    "model_id": {
      "const": "signal-space.ss-ocf-1.flat-axisymmetric-neutral-clock.v1"
    },
    "parameters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "separation", "scenarios"],
      "properties": {
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": {
              "const": "research/experiments/gross.bound-clock.v1/run-080a63d117abd84d/attempts/attempt-0001/raw/profile-0.900.npz"
            },
            "sha256": {
              "const": "6b1e06d47b6a9236698f044e103764b397b77c16f927ab2f1e539f263d43a3db"
            }
          }
        },
        "separation": { "type": "number", "minimum": 71.2, "maximum": 90 },
        "scenarios": {
          "type": "array",
          "minItems": 2,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "pair",
              "h",
              "dt",
              "radius",
              "half_length",
              "duration",
              "sample_stride"
            ],
            "properties": {
              "label": { "type": "string", "pattern": "^[a-z0-9-]+$" },
              "pair": { "type": "boolean" },
              "h": { "type": "number", "minimum": 0.1, "maximum": 1 },
              "dt": { "type": "number", "exclusiveMinimum": 0, "maximum": 0.1 },
              "radius": { "type": "number", "minimum": 22, "maximum": 120 },
              "half_length": {
                "type": "number",
                "minimum": 25,
                "maximum": 180
              },
              "duration": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 40
              },
              "sample_stride": {
                "type": "integer",
                "minimum": 1,
                "maximum": 200
              }
            }
          }
        }
      }
    },
    "units": {
      "const": {
        "mass": "m=1",
        "length": "m^-1",
        "time": "m^-1",
        "signal": "c=hbar=1"
      }
    },
    "seeds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["root"],
      "properties": { "root": { "type": "integer", "minimum": 0 } }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cpu_seconds",
        "max_wall_seconds",
        "max_memory_mb",
        "max_output_mb"
      ],
      "properties": {
        "max_cpu_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "max_wall_seconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "max_memory_mb": { "type": "integer", "minimum": 64, "maximum": 1024 },
        "max_output_mb": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "analysis": {
      "const": {
        "max_energy_drift_fraction": 0.001,
        "max_charge_drift_fraction": 0.001,
        "require_exact_neutral_null": true,
        "full_acceptance": "not-evaluated"
      }
    },
    "report": {
      "const": { "title": "Test 8: spatial calibration feasibility pilot" }
    }
  }
}
